---
import config from 'virtual:starlight/user-config';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';

const shouldRenderSearch =
  config.pagefind ||
  config.components?.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header sl-flex">
  <div class="sl-flex brand-section">
    <a class="site-title" href="/">
      <div class="logo">
        <img src="/images/logo.png" alt="Escudo de Cea" width="40" height="40" />
      </div>
      <div class="title-text">
        <span class="main-title">{config.title}</span>
        <span class="subtitle">León, España</span>
      </div>
    </a>
  </div>
  
  <div class="sl-flex search-section">
    {shouldRenderSearch && <Search {...Astro.props} />}
  </div>
  
  <div class="sl-flex right-group">
    <nav class="quick-nav">
      <a href="/parte-1-capitulo-1/" class="nav-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
        <span>Historia</span>
      </a>
      <a href="/castillo/torre/" class="nav-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 21h18"/>
          <path d="M5 21V7l8-4v18"/>
          <path d="M19 21V11l-6-4"/>
        </svg>
        <span>Castillo</span>
      </a>
      <a href="/indice/" class="nav-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
        <span>Índice</span>
      </a>
    </nav>
    
    <div class="controls">
      <ThemeSelect {...Astro.props} />
      <LanguageSelect {...Astro.props} />
    </div>
  </div>
</div>

<style>
  .header {
    gap: var(--sl-nav-gap, 1rem);
    justify-content: space-between;
    align-items: center;
    height: 100%;
    padding: 0 1rem;
    background: linear-gradient(135deg, #faf5f0 0%, #f5ebe0 100%);
    border-bottom: 1px solid #d2b48c;
    backdrop-filter: blur(10px);
  }

  .brand-section {
    flex-shrink: 0;
    min-width: 0;
    max-width: none;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    font-weight: 600;
    transition: all 0.2s ease;
    padding: 0.5rem;
    border-radius: 12px;
  }

  .site-title:hover {
    background: rgba(139, 69, 19, 0.05);
    transform: translateY(-1px);
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
    border-radius: 10px;
    color: white;
    box-shadow: 0 2px 8px rgba(139, 69, 19, 0.3);
    padding: 2px;
  }

  .logo img {
    width: 36px;
    height: 36px;
    border-radius: 8px;
  }

  .title-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .main-title {
    font-size: 1rem;
    font-weight: 700;
    color: #5D4037;
    line-height: 1.2;
    white-space: nowrap;
    overflow: visible;
  }

  .subtitle {
    font-size: 0.75rem;
    color: #8D6E63;
    font-weight: 500;
    opacity: 0.8;
  }

  .search-section {
    flex: 1;
    max-width: 400px;
    justify-content: center;
  }

  .right-group {
    gap: 1rem;
    align-items: center;
    flex-shrink: 0;
  }

  .quick-nav {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: #6D4C41;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .nav-link:hover {
    background: #8B4513;
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(139, 69, 19, 0.3);
  }

  .nav-link svg {
    width: 14px;
    height: 14px;
  }

  .controls {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    border-left: 1px solid #d2b48c;
    padding-left: 1rem;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .header {
      padding: 0 0.75rem;
      gap: 0.75rem;
    }

    .title-text .main-title {
      font-size: 1rem;
    }

    .subtitle {
      display: none;
    }

    .quick-nav {
      gap: 0.25rem;
    }

    .nav-link span {
      display: none;
    }

    .nav-link {
      padding: 0.5rem;
    }

    .search-section {
      max-width: 200px;
    }

    .controls {
      padding-left: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .logo {
      width: 36px;
      height: 36px;
    }

    .logo svg {
      width: 28px;
      height: 28px;
    }

    .quick-nav {
      display: none;
    }

    .controls {
      border: none;
      padding-left: 0;
    }
  }

  /* Dark mode support */
  :global([data-theme="dark"]) .header {
    background: linear-gradient(135deg, #3E2723 0%, #1B0000 100%);
    border-bottom-color: #5D4037;
  }

  :global([data-theme="dark"]) .main-title {
    color: #EFEBE9;
  }

  :global([data-theme="dark"]) .subtitle {
    color: #A1887F;
  }

  :global([data-theme="dark"]) .nav-link {
    color: #BCAAA4;
  }

  :global([data-theme="dark"]) .controls {
    border-left-color: #5D4037;
  }

  :global([data-theme="dark"]) .site-title:hover {
    background: rgba(139, 69, 19, 0.1);
  }
</style>
