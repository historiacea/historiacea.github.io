---
import config from 'virtual:starlight/user-config';
---

<footer class="custom-footer">
  <div class="footer-content">
    <div class="footer-section brand-section">
      <div class="footer-logo">
        <img src="/images/logo.png" alt="Escudo de Cea" width="48" height="48" />
      </div>
      <div class="footer-text">
        <h3>{config.title}</h3>
        <p>Preservando la memoria histórica de Cea, León</p>
      </div>
    </div>

    <div class="footer-section navigation-section">
      <h4>Navegación</h4>
      <nav class="footer-nav">
        <a href="/" class="footer-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
          Inicio
        </a>
        <a href="/parte-1-capitulo-1/" class="footer-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          Historia
        </a>
        <a href="/castillo/torre/" class="footer-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 21h18"/>
            <path d="M5 21V7l8-4v18"/>
            <path d="M19 21V11l-6-4"/>
          </svg>
          Castillo
        </a>
        <a href="/cronologia/" class="footer-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12,6 12,12 16,14"/>
          </svg>
          Cronología
        </a>
      </nav>
    </div>

    <div class="footer-section legal-section">
      <h4>Información Legal</h4>
      <nav class="footer-nav">
        <a href="/aviso-legal/" class="footer-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
          Aviso Legal
        </a>
        <a href="https://github.com/historiacea/historiacea.github.io" target="_blank" class="footer-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          GitHub
        </a>
      </nav>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-copyright">
      <p>© {new Date().getFullYear()} Historia de Cea. Proyecto sin ánimo de lucro dedicado a preservar la memoria histórica.</p>
    </div>
  </div>
</footer>

<style>
  .custom-footer {
    background: linear-gradient(135deg, #faf5f0 0%, #f5ebe0 100%);
    border-top: 1px solid #d2b48c;
    margin-top: auto;
    padding: 2.5rem 1rem 1.5rem;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .footer-section h3,
  .footer-section h4 {
    margin: 0 0 1rem 0;
    font-weight: 600;
    color: #5D4037;
  }

  .footer-section h3 {
    font-size: 1.25rem;
  }

  .footer-section h4 {
    font-size: 1rem;
  }

  .brand-section {
    display: flex;
    align-items: start;
    gap: 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
    border-radius: 12px;
    color: white;
    box-shadow: 0 4px 12px rgba(139, 69, 19, 0.3);
    flex-shrink: 0;
    padding: 2px;
  }

  .footer-logo img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
  }

  .footer-text p {
    margin: 0.5rem 0 0 0;
    color: #8D6E63;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #6D4C41;
    font-size: 0.9rem;
    padding: 0.5rem 0;
    transition: all 0.2s ease;
    border-radius: 6px;
  }

  .footer-link:hover {
    color: #8B4513;
    transform: translateX(4px);
  }

  .footer-link svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .footer-bottom {
    max-width: 1200px;
    margin: 2rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid #d2b48c;
  }

  .footer-copyright p {
    margin: 0;
    color: #8D6E63;
    font-size: 0.85rem;
    text-align: center;
    line-height: 1.5;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .custom-footer {
      padding: 2rem 1rem 1rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .brand-section {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .navigation-section,
    .legal-section {
      text-align: center;
    }

    .footer-nav {
      align-items: center;
    }

    .footer-link:hover {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 480px) {
    .footer-logo {
      width: 40px;
      height: 40px;
    }

    .footer-logo svg {
      width: 28px;
      height: 28px;
    }
  }

  /* Dark mode support */
  :global([data-theme="dark"]) .custom-footer {
    background: linear-gradient(135deg, #3E2723 0%, #1B0000 100%);
    border-top-color: #5D4037;
  }

  :global([data-theme="dark"]) .footer-section h3,
  :global([data-theme="dark"]) .footer-section h4 {
    color: #EFEBE9;
  }

  :global([data-theme="dark"]) .footer-text p {
    color: #A1887F;
  }

  :global([data-theme="dark"]) .footer-link {
    color: #BCAAA4;
  }

  :global([data-theme="dark"]) .footer-link:hover {
    color: #D7CCC8;
  }

  :global([data-theme="dark"]) .footer-bottom {
    border-top-color: #5D4037;
  }

  :global([data-theme="dark"]) .footer-copyright p {
    color: #A1887F;
  }
</style>