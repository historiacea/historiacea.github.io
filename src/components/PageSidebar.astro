---
import type { Props } from '@astrojs/starlight/props';
import TableOfContentsList from '@astrojs/starlight/components/TableOfContents/TableOfContentsList.astro';

const { toc, labels } = Astro.props;
---

{
	toc && (
		<nav class="right-sidebar" aria-labelledby="starlight__on-this-page">
			<div class="starlight-toc">
				<h2 id="starlight__on-this-page">{labels['tableOfContents.onThisPage']}</h2>
				<TableOfContentsList toc={toc.items} />
			</div>
		</nav>
	)
}

<style>
	.right-sidebar {
		position: fixed;
		right: 0;
		top: var(--sl-nav-height);
		width: fit-content;
		min-width: 200px;
		max-width: 320px;
		height: calc(100vh - var(--sl-nav-height));
		overflow-y: auto;
		background-color: var(--sl-color-bg-sidebar);
		border-left: 1px solid var(--sl-color-hairline-shade);
		z-index: 10;
		padding: 1.5rem 1rem;
	}

	.starlight-toc h2 {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--sl-color-text-accent);
		margin-bottom: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}

	/* Ajustar el contenido principal */
	:global(.main-frame) {
		margin-right: clamp(200px, 25vw, 320px);
	}

	/* En dispositivos más pequeños, ocultar el sidebar derecho */
	@media (max-width: 1200px) {
		.right-sidebar {
			display: none;
		}
		
		:global(.main-frame) {
			margin-right: 0;
		}
	}

	/* Estilos para dark mode */
	:global([data-theme="dark"]) .right-sidebar {
		background-color: var(--sl-color-bg-sidebar);
		border-left-color: var(--sl-color-hairline-shade);
	}

	/* Mejorar el scrollbar */
	.right-sidebar {
		scrollbar-width: thin;
		scrollbar-color: var(--sl-color-hairline-shade) transparent;
	}

	.right-sidebar::-webkit-scrollbar {
		width: 6px;
	}

	.right-sidebar::-webkit-scrollbar-track {
		background: transparent;
	}

	.right-sidebar::-webkit-scrollbar-thumb {
		background-color: var(--sl-color-hairline-shade);
		border-radius: 3px;
	}

	.right-sidebar::-webkit-scrollbar-thumb:hover {
		background-color: var(--sl-color-text-invert);
	}
</style>