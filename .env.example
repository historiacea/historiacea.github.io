# Configuración de Algolia
# Copia este archivo a .env y completa con tus credenciales reales

# App ID de Algolia (lo encuentras en tu dashboard)
ALGOLIA_APP_ID=TU_APP_ID

# Admin API Key de Algolia (SOLO para indexar, nunca expongas esta clave públicamente)
ALGOLIA_ADMIN_API_KEY=TU_ADMIN_API_KEY

# Search-Only API Key (esta va en docusaurus.config.ts)
ALGOLIA_SEARCH_API_KEY=TU_SEARCH_API_KEY

# Nombre del índice
ALGOLIA_INDEX_NAME=historiacea